        {
          "name": "Submissão CARAT - Respostas Incompletas (RF18 - erro esperado)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400 - Respostas incompletas rejeitadas', function() {",
