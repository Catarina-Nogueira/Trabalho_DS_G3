        {
          "name": "Submissão CARAT - Completa com Score Controlado (RF17, RF19, RF20, RF21, RF25)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 - Avaliação criada', function() {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Score total calculado', function() {",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.avaliacao.score_total).to.be.a('number');",
                  "});",
                  "pm.test('Nível de controlo determinado', function() {",
                  "  var json = pm.response.json();",
                  "  pm.expect(['controlado','parcialmente_controlado','nao_controlado']).to.include(json.avaliacao.nivel_controlo);",
                  "});",
                  "pm.test('Recomendações geradas automaticamente', function() {",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.recomendacoes.length).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
