      "name": "3. Módulo CARAT",
      "item": [
        {
          "name": "Obter Questionário CARAT Ativo (RF16)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 - Questionário devolvido', function() {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Questionário tem 10 questões', function() {",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.questoes.length).to.equal(10);",
                  "});",
                  "pm.test('Versão do questionário correcta', function() {",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.versao).to.equal('V1_2026');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
